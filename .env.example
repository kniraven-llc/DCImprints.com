# =============================================================================
# DC Imprints - Example Environment Configuration
# =============================================================================
# Copy this file to ".env" and replace the example values with the real
# production credentials/settings.
#
# IMPORTANT:
# - Never commit the real .env file to Git.
# - The values below are examples only.
# - Do not use these example passwords, IDs, or secrets in production.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME="DC Imprints"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://dcimprints.com
APP_TIMEZONE=America/Chicago
SESSION_NAME=dcimprints_session


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dcimprints
DB_USERNAME=root
DB_PASSWORD=


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# MAIL_TO:
# Address that receives quote requests submitted through the website.
#
# MAIL_FROM_ADDRESS:
# Microsoft 365 mailbox the website sends the message from.
# This mailbox must exist in the DC Imprints Microsoft 365 tenant and the
# Microsoft Graph application must have permission to send mail from it.
#
# MAIL_FROM_NAME:
# Friendly sender name shown in Outlook/email clients.

MAIL_TO=example@website.com
MAIL_FROM_ADDRESS=example@website.com
MAIL_FROM_NAME="[TEST] DC Imprints Website Test"


# -----------------------------------------------------------------------------
# Microsoft Graph
# -----------------------------------------------------------------------------
# These values come from the Microsoft Entra app registration created for
# the DC Imprints website.
#
# MS_GRAPH_TENANT_ID:
# The Microsoft 365 / Entra tenant's Directory (tenant) ID.
# Format: UUID
#
# MS_GRAPH_CLIENT_ID:
# The Application (client) ID of the DC Imprints website app registration.
# Format: UUID
#
# MS_GRAPH_CLIENT_SECRET:
# The secret VALUE generated under the app registration's
# Certificates & secrets section.
#
# IMPORTANT:
# Use the client secret VALUE, not the Secret ID.

MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000001
MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000002
MS_GRAPH_CLIENT_SECRET="not-a-real-client-secret"

# -----------------------------------------------------------------------------
# Google Analytics
# -----------------------------------------------------------------------------
# The GA4 Measurement ID for the website's Web data stream.
#
# It normally begins with "G-".
#
# Example:
# GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Leave this blank to disable Google Analytics.

GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX